{
  "request": {
    "method": "POST",
    "urlPath": "/s1/subscribe",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer catalog-token"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": {
          "account": {
            "ref": "U2"
          },
          "product": {
            "code": "S1-A",
            "subcode": "X1"
          }
        }
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "downstream failure"
    }
  }
}
