{
  "request": {
    "method": "POST",
    "urlPath": "/s1/subscribe",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer catalog-token"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": {
          "account": {
            "ref": "U1"
          },
          "product": {
            "code": "S1-A",
            "subcode": "X1"
          }
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "state": "ACTIVE",
      "subscriptionId": "s1-test"
    }
  }
}
