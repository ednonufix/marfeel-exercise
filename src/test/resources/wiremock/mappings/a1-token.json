{
  "request": {
    "method": "POST",
    "urlPath": "/a1/token",
    "headers": {
      "Authorization": {
        "absent": true
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "token": "catalog-token",
      "expires_in": 300
    }
  }
}
