<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="003-restore-subscriptions" author="enoel" dbms="mysql">
		<preConditions onFail="MARK_RAN">
			<columnExists tableName="subscriptions" columnName="status"/>
		</preConditions>
		<delete tableName="subscriptions">
			<where>status = 'IN_PROGRESS' AND provider_subscription_id IS NULL</where>
		</delete>
		<sql>
			ALTER TABLE subscriptions
				MODIFY provider_subscription_id VARCHAR(255) NOT NULL,
				DROP COLUMN status
		</sql>
	</changeSet>
</databaseChangeLog>
