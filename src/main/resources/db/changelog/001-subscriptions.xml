<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="001-create-subscriptions" author="enoel" dbms="mysql">
		<createTable tableName="subscriptions">
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="user_id" type="VARCHAR(64)">
				<constraints nullable="false"/>
			</column>
			<column name="service" type="VARCHAR(2)">
				<constraints nullable="false"/>
			</column>
			<column name="product_code" type="VARCHAR(128)">
				<constraints nullable="false"/>
			</column>
			<column name="product_subcode" type="VARCHAR(128)">
				<constraints nullable="false"/>
			</column>
			<column name="provider_subscription_id" type="VARCHAR(255)">
				<constraints nullable="false"/>
			</column>
			<column name="subscribed_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addUniqueConstraint tableName="subscriptions"
		                     columnNames="user_id, service, product_code, product_subcode"
		                     constraintName="uq_subscriptions_user_product"/>
		<sql><![CDATA[
			ALTER TABLE subscriptions
				ADD CONSTRAINT chk_subscriptions_product_ref CHECK (
					(service = 'S1' AND product_subcode <> '')
						OR (service = 'S2' AND product_subcode = '')
					);
			]]></sql>
		<rollback>
			<dropTable tableName="subscriptions"/>
		</rollback>
	</changeSet>

	<changeSet id="002-create-subscription-attempts" author="enoel" dbms="mysql">
		<createTable tableName="subscription_attempts">
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="user_id" type="VARCHAR(64)">
				<constraints nullable="false"/>
			</column>
			<column name="service" type="VARCHAR(2)">
				<constraints nullable="false"/>
			</column>
			<column name="product_code" type="VARCHAR(128)">
				<constraints nullable="false"/>
			</column>
			<column name="product_subcode" type="VARCHAR(128)">
				<constraints nullable="false"/>
			</column>
			<column name="subscription_status" type="VARCHAR(7)">
				<constraints nullable="false"/>
			</column>
			<column name="failure_reason" type="VARCHAR(512)"/>
			<column name="attempted_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<createIndex tableName="subscription_attempts" indexName="ix_subscription_attempts_user_date">
			<column name="user_id"/>
			<column name="attempted_at"/>
		</createIndex>
		<createIndex tableName="subscription_attempts" indexName="ix_subscription_attempts_user_status_date">
			<column name="user_id"/>
			<column name="subscription_status"/>
			<column name="attempted_at"/>
		</createIndex>
		<sql><![CDATA[
			ALTER TABLE subscription_attempts
				ADD CONSTRAINT chk_subscription_attempts_product_ref CHECK (
					(service = 'S1' AND product_subcode <> '')
						OR (service = 'S2' AND product_subcode = '')
					),
				ADD CONSTRAINT chk_subscription_attempts_status CHECK (
					subscription_status IN ('SUCCESS', 'FAILED')
					);
			]]></sql>
		<rollback>
			<dropTable tableName="subscription_attempts"/>
		</rollback>
	</changeSet>

</databaseChangeLog>
