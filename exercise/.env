# Published host ports — change freely, no rebuild needed.
A1_PORT=8081
S1_PORT=8082
S2_PORT=8083
S3_PORT=8084
DB_PORT=3307

# Mock behavior knobs.
A1_TOKEN_TTL=300            # A1 token validity, seconds (spec: 5 min)
S1_LATENCY_MS=600         # S1 POST sleep, ms (spec: ~60s). Lower it while developing.
S2_API_KEY=s2-secret-key    # static token S2 expects in the X-Api-Key header
S3_TOKEN=s3-static-token    # static bearer S3 expects (NOT issued by A1)
S3_LATENCY_MS=150           # S3 metrics latency, ms

# Database (MySQL) for the registry the candidate builds.
DB_USER=registry
DB_PASSWORD=registry
DB_NAME=registry
DB_ROOT_PASSWORD=root
